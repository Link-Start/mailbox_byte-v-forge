{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-email-relay",
  "account_id": "04d289f3ff972711c415793f0b7da61d",
  "main": "src/index.js",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "EMAIL_EVENT_CACHE",
      "id": "483d15b7182047d88467af6f947ee63f"
    }
  ],
  "upload_source_maps": true,
  "vars": {
    "MAILBOX_WEBHOOK_URL": "https://hook.tibo-nice.space/webhooks/email/cloudflare",
    "WEBHOOK_FAIL_OPEN": "false",
    "EMAIL_EVENT_CACHE_TTL_SECONDS": "259200"
  }
}
