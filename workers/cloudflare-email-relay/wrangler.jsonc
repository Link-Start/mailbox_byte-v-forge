{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-email-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Create a KV namespace and add its real id to enable pending-email pull cache.
  // "kv_namespaces": [{ "binding": "EMAIL_EVENT_CACHE", "id": "<kv_namespace_id>" }],
  "upload_source_maps": true,
  "vars": {
    "MAILBOX_WEBHOOK_URL": "https://mailbox.example.invalid/webhooks/email/cloudflare",
    "WEBHOOK_FAIL_OPEN": "false",
    "EMAIL_EVENT_CACHE_TTL_SECONDS": "259200"
  }
}
